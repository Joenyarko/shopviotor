# Frontend Environment Variables
# Rename this file to .env for local development

# ─── API ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── Paystack ────────────────────────────────────────────────────
# Replace with your Paystack PUBLIC key (starts with pk_test_ or pk_live_)
# NEVER put your secret key here
VITE_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# ─── App ─────────────────────────────────────────────────────────
VITE_APP_NAME=VIOTOR
VITE_APP_URL=http://localhost:5173
